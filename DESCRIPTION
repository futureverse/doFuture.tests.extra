Package: doFuture.tests.extra
Version: 0.2.0-9002
Title: Extra Test Sets for the 'doFuture' Package
Depends:
    doFuture (>= 1.1.0)
Imports:
    future (>= 1.80.0)
Suggests:
    tools,
    BiocParallel,
    caret,
        mda, earth, mlbench, fastICA, klaR, MLmetrics, randomForest, gam,
    doParallel,
    future.batchtools,
    future.callr,
    glmnet,
       	lars,
    NMF,
